{
  "$defs": {
    "AllowableMaterial": {
      "enum": [
        "void",
        "soft",
        "hard",
        "glass",
        "joint",
        "light",
        "signal"
      ],
      "title": "AllowableMaterial",
      "type": "string"
    },
    "AnimationState": {
      "enum": [
        "idle",
        "blink",
        "sleep",
        "beg",
        "ill"
      ],
      "title": "AnimationState",
      "type": "string"
    },
    "BehaviorContract": {
      "additionalProperties": false,
      "properties": {
        "curiosity": {
          "maximum": 1,
          "minimum": 0,
          "title": "Curiosity",
          "type": "number"
        },
        "neediness": {
          "maximum": 1,
          "minimum": 0,
          "title": "Neediness",
          "type": "number"
        },
        "sleepiness": {
          "maximum": 1,
          "minimum": 0,
          "title": "Sleepiness",
          "type": "number"
        }
      },
      "required": [
        "curiosity",
        "neediness",
        "sleepiness"
      ],
      "title": "BehaviorContract",
      "type": "object"
    },
    "DeliberationContract": {
      "additionalProperties": false,
      "properties": {
        "max_ticks": {
          "maximum": 8,
          "minimum": 2,
          "title": "Max Ticks",
          "type": "integer"
        },
        "confidence_threshold": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Confidence Threshold",
          "type": "number"
        }
      },
      "required": [
        "max_ticks",
        "confidence_threshold"
      ],
      "title": "DeliberationContract",
      "type": "object"
    },
    "ForbiddableMaterial": {
      "enum": [
        "soft",
        "hard",
        "glass",
        "joint",
        "light",
        "signal"
      ],
      "title": "ForbiddableMaterial",
      "type": "string"
    },
    "ForbiddableRole": {
      "enum": [
        "body",
        "shell",
        "sensor",
        "eye",
        "mouth",
        "joint",
        "limb",
        "antenna",
        "decoration",
        "effect",
        "anchor"
      ],
      "title": "ForbiddableRole",
      "type": "string"
    },
    "ForbiddenTraitsContract": {
      "additionalProperties": false,
      "properties": {
        "roles": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/ForbiddableRole"
              },
              "minItems": 1,
              "type": "array",
              "uniqueItems": true
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Roles"
        },
        "materials": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/ForbiddableMaterial"
              },
              "minItems": 1,
              "type": "array",
              "uniqueItems": true
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Materials"
        }
      },
      "title": "ForbiddenTraitsContract",
      "type": "object"
    },
    "GridContract": {
      "additionalProperties": false,
      "properties": {
        "allowed_palettes": {
          "items": {
            "$ref": "#/$defs/PaletteId"
          },
          "minItems": 1,
          "title": "Allowed Palettes",
          "type": "array",
          "uniqueItems": true
        },
        "body_mass_min": {
          "minimum": 1,
          "title": "Body Mass Min",
          "type": "integer"
        },
        "body_mass_max": {
          "minimum": 1,
          "title": "Body Mass Max",
          "type": "integer"
        },
        "required_organ_roles": {
          "items": {
            "$ref": "#/$defs/OrganRole"
          },
          "minItems": 1,
          "title": "Required Organ Roles",
          "type": "array",
          "uniqueItems": true
        }
      },
      "required": [
        "allowed_palettes",
        "body_mass_min",
        "body_mass_max",
        "required_organ_roles"
      ],
      "title": "GridContract",
      "type": "object"
    },
    "LineagePreferencesContract": {
      "additionalProperties": false,
      "properties": {
        "parent_selection": {
          "enum": [
            "uniform",
            "fitness_weighted"
          ],
          "title": "Parent Selection",
          "type": "string"
        }
      },
      "required": [
        "parent_selection"
      ],
      "title": "LineagePreferencesContract",
      "type": "object"
    },
    "MutationContract": {
      "additionalProperties": false,
      "properties": {
        "cell_mutation_rate_max": {
          "maximum": 1,
          "minimum": 0,
          "title": "Cell Mutation Rate Max",
          "type": "number"
        },
        "organ_shift_rate_max": {
          "maximum": 1,
          "minimum": 0,
          "title": "Organ Shift Rate Max",
          "type": "number"
        },
        "palette_shift_rate_max": {
          "maximum": 1,
          "minimum": 0,
          "title": "Palette Shift Rate Max",
          "type": "number"
        },
        "symmetry_break_rate_max": {
          "maximum": 1,
          "minimum": 0,
          "title": "Symmetry Break Rate Max",
          "type": "number"
        }
      },
      "required": [
        "cell_mutation_rate_max",
        "organ_shift_rate_max",
        "palette_shift_rate_max",
        "symmetry_break_rate_max"
      ],
      "title": "MutationContract",
      "type": "object"
    },
    "OrganRole": {
      "enum": [
        "sensor",
        "expression",
        "body_core"
      ],
      "title": "OrganRole",
      "type": "string"
    },
    "PaletteId": {
      "enum": [
        "lcd_green",
        "gameboy_gray",
        "amber_terminal",
        "crt_blue",
        "pocket_plum"
      ],
      "title": "PaletteId",
      "type": "string"
    },
    "RiskTolerancesContract": {
      "additionalProperties": false,
      "properties": {
        "mutation": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Mutation",
          "type": "number"
        }
      },
      "required": [
        "mutation"
      ],
      "title": "RiskTolerancesContract",
      "type": "object"
    },
    "SurvivalWeightsContract": {
      "additionalProperties": false,
      "properties": {
        "stability": {
          "maximum": 1,
          "minimum": 0,
          "title": "Stability",
          "type": "number"
        },
        "novelty": {
          "maximum": 1,
          "minimum": 0,
          "title": "Novelty",
          "type": "number"
        },
        "bond": {
          "maximum": 1,
          "minimum": 0,
          "title": "Bond",
          "type": "number"
        }
      },
      "required": [
        "stability",
        "novelty",
        "bond"
      ],
      "title": "SurvivalWeightsContract",
      "type": "object"
    },
    "SwitchboardThread": {
      "enum": [
        "recent_interaction_ewma",
        "hidden_mood_estimator",
        "action_preference_bandit",
        "mutation_risk_scorer"
      ],
      "title": "SwitchboardThread",
      "type": "string"
    },
    "VisualGrammarContract": {
      "additionalProperties": false,
      "properties": {
        "allowed_materials": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/AllowableMaterial"
              },
              "minItems": 1,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Allowed Materials"
        },
        "animation_vocab": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/AnimationState"
              },
              "minItems": 1,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Animation Vocab"
        }
      },
      "title": "VisualGrammarContract",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "slip_version": {
      "enum": [
        "0.1.0",
        "0.2.0"
      ],
      "title": "Slip Version",
      "type": "string"
    },
    "profile_id": {
      "minLength": 1,
      "pattern": "^[a-z0-9_]+$",
      "title": "Profile Id",
      "type": "string"
    },
    "name": {
      "minLength": 1,
      "title": "Name",
      "type": "string"
    },
    "grid": {
      "$ref": "#/$defs/GridContract"
    },
    "mutation": {
      "$ref": "#/$defs/MutationContract"
    },
    "behavior": {
      "$ref": "#/$defs/BehaviorContract"
    },
    "survival_weights": {
      "$ref": "#/$defs/SurvivalWeightsContract"
    },
    "forbidden_traits": {
      "anyOf": [
        {
          "$ref": "#/$defs/ForbiddenTraitsContract"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "risk_tolerances": {
      "anyOf": [
        {
          "$ref": "#/$defs/RiskTolerancesContract"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "lineage_preferences": {
      "anyOf": [
        {
          "$ref": "#/$defs/LineagePreferencesContract"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "species_class": {
      "anyOf": [
        {
          "minLength": 1,
          "pattern": "^[a-z0-9_]+$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Species Class"
    },
    "visual_grammar": {
      "anyOf": [
        {
          "$ref": "#/$defs/VisualGrammarContract"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "deliberation": {
      "anyOf": [
        {
          "$ref": "#/$defs/DeliberationContract"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "learning_switches": {
      "anyOf": [
        {
          "additionalProperties": {
            "type": "boolean"
          },
          "minProperties": 1,
          "propertyNames": {
            "$ref": "#/$defs/SwitchboardThread"
          },
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Learning Switches"
    }
  },
  "required": [
    "slip_version",
    "profile_id",
    "name",
    "grid",
    "mutation",
    "behavior",
    "survival_weights"
  ],
  "title": "Mechagotchi SLIP Pydantic Contract",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mechagotchi.local/schema/slip/pydantic/0.1.0"
}
