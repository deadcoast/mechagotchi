{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mechagotchi.local/schema/slip/0.1.0",
  "title": "Mechagotchi SLIP Profile",
  "description": "Stage 0 Synthetic Learning Intelligence Profile contract for authoring constraints, priors, mutation caps, and behavior weights.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "slip_version",
    "profile_id",
    "name",
    "grid",
    "mutation",
    "behavior",
    "survival_weights"
  ],
  "properties": {
    "slip_version": {
      "enum": [
        "0.1.0",
        "0.2.0"
      ]
    },
    "profile_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z0-9_]+$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "grid": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "allowed_palettes",
        "body_mass_min",
        "body_mass_max",
        "required_organ_roles"
      ],
      "properties": {
        "allowed_palettes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "lcd_green",
              "gameboy_gray",
              "amber_terminal",
              "crt_blue",
              "pocket_plum"
            ]
          }
        },
        "body_mass_min": {
          "type": "integer",
          "minimum": 1
        },
        "body_mass_max": {
          "type": "integer",
          "minimum": 1
        },
        "required_organ_roles": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "sensor",
              "expression",
              "body_core"
            ]
          }
        }
      }
    },
    "mutation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cell_mutation_rate_max",
        "organ_shift_rate_max",
        "palette_shift_rate_max",
        "symmetry_break_rate_max"
      ],
      "properties": {
        "cell_mutation_rate_max": {
          "$ref": "#/$defs/unit_interval"
        },
        "organ_shift_rate_max": {
          "$ref": "#/$defs/unit_interval"
        },
        "palette_shift_rate_max": {
          "$ref": "#/$defs/unit_interval"
        },
        "symmetry_break_rate_max": {
          "$ref": "#/$defs/unit_interval"
        }
      }
    },
    "behavior": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "curiosity",
        "neediness",
        "sleepiness"
      ],
      "properties": {
        "curiosity": {
          "$ref": "#/$defs/unit_interval"
        },
        "neediness": {
          "$ref": "#/$defs/unit_interval"
        },
        "sleepiness": {
          "$ref": "#/$defs/unit_interval"
        }
      }
    },
    "survival_weights": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stability",
        "novelty",
        "bond"
      ],
      "properties": {
        "stability": {
          "$ref": "#/$defs/unit_interval"
        },
        "novelty": {
          "$ref": "#/$defs/unit_interval"
        },
        "bond": {
          "$ref": "#/$defs/unit_interval"
        }
      }
    },
    "forbidden_traits": {
      "type": "object",
      "description": "SLIP schema extension ladder rung T3.1 (decision record 0012): cell roles/materials a compliant grid must not contain. Legal only under slip_version 0.2.0.",
      "properties": {
        "roles": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "body",
              "shell",
              "sensor",
              "eye",
              "mouth",
              "joint",
              "limb",
              "antenna",
              "decoration",
              "effect",
              "anchor"
            ]
          }
        },
        "materials": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "soft",
              "hard",
              "glass",
              "joint",
              "light",
              "signal"
            ]
          }
        }
      },
      "additionalProperties": false,
      "anyOf": [
        {
          "required": [
            "roles"
          ]
        },
        {
          "required": [
            "materials"
          ]
        }
      ]
    },
    "risk_tolerances": {
      "type": "object",
      "description": "SLIP schema extension ladder rung T3.2 (decision record 0012): how much risk the species tolerates. `mutation` is the risk level at which mutation utility flips negative in the switchboard (baseline 0.35 when absent). 0.2.0-only.",
      "properties": {
        "mutation": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 1.0
        }
      },
      "required": [
        "mutation"
      ],
      "additionalProperties": false
    },
    "learning_switches": {
      "type": "object",
      "description": "SLIP schema extension ladder rung T3.3 (decision record 0012): the og learning toggles \u2014 per-thread switchboard gates (absent or true = on). 0.2.0-only.",
      "minProperties": 1,
      "properties": {
        "recent_interaction_ewma": {
          "type": "boolean"
        },
        "hidden_mood_estimator": {
          "type": "boolean"
        },
        "action_preference_bandit": {
          "type": "boolean"
        },
        "mutation_risk_scorer": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "lineage_preferences": {
      "type": "object",
      "description": "SLIP schema extension ladder rung T3.4 (decision record 0012): how the species selects parents from the archive. fitness_weighted breeds from the fittest elites first; uniform is the frozen baseline (round-robin over sorted niches). 0.2.0-only.",
      "properties": {
        "parent_selection": {
          "enum": [
            "uniform",
            "fitness_weighted"
          ]
        }
      },
      "required": [
        "parent_selection"
      ],
      "additionalProperties": false
    },
    "species_class": {
      "type": "string",
      "pattern": "^[a-z0-9_]+$",
      "minLength": 1,
      "description": "Ladder rung T3.5 (DR 0012): species taxonomy label. 0.2.0-only."
    },
    "visual_grammar": {
      "type": "object",
      "description": "Ladder rung T3.5 (DR 0012): the species' visual language \u2014 allowed cell materials (alignment-enforced) and its animation vocabulary (packet-v2 selection honors it; idle mandatory). 0.2.0-only.",
      "minProperties": 1,
      "properties": {
        "allowed_materials": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "void",
              "soft",
              "hard",
              "glass",
              "joint",
              "light",
              "signal"
            ]
          }
        },
        "animation_vocab": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "contains": {
            "const": "idle"
          },
          "items": {
            "enum": [
              "idle",
              "blink",
              "sleep",
              "beg",
              "ill"
            ]
          }
        }
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "unit_interval": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "slip_version": {
            "const": "0.1.0"
          }
        }
      },
      "then": {
        "not": {
          "anyOf": [
            {
              "required": [
                "forbidden_traits"
              ]
            },
            {
              "required": [
                "risk_tolerances"
              ]
            },
            {
              "required": [
                "learning_switches"
              ]
            },
            {
              "required": [
                "lineage_preferences"
              ]
            },
            {
              "required": [
                "species_class"
              ]
            },
            {
              "required": [
                "visual_grammar"
              ]
            }
          ]
        }
      }
    }
  ]
}
