# Python bytecode. The old tracked-bytecode hazard was closed in cycle
# 07 V3 (all 144 tracked .pyc files untracked); this rule keeps it so.
__pycache__/
*.pyc

# CI diagnostics are retained as workflow artifacts, never source.
/.ci-logs/

# Local environments
.venv/

# Backups the mechas rating server writes before overwriting ratings
data/readability/*.bak.csv

# Workshop grid backups (backup-before-overwrite safety copies)
data/workshop/grids/*.bak.json

# Keeper session play state (a live game, not evidence — the stage-0
# artifacts one level up stay committed)
data/game_loop/keeper/

# The game client's save home (F2, DR 0033): lineage files and play
# state from real sessions — a live pet is not evidence
/keeper/

# Build artifacts from uv/setuptools resolving the path-dependency
# builds (game -> mecha-engine): never evidence, never source
build/
*.egg-info/
# The game's own lock is decided at F5 (packaging rung); the root
# uv.lock is the workspace lock of record
game/uv.lock

# F5 release builds (game/build_release.py output): installers are
# built, never committed
game/dist*/
game/release_work/

# Resumable local development runs; committed research evidence stays under data/.
/.development/
